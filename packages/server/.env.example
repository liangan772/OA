# 复制为 .env 后按需修改
# 生产环境请务必更换 JWT_SECRET 与数据库口令

# 本地内嵌库（npm --prefix packages/server run db:dev）：55432
# Docker Compose 环境会被覆盖为 postgres://oooa:oooa@postgres:5432/oooa
DATABASE_URL="postgresql://oooa:oooa@localhost:55432/oooa?schema=public"

REDIS_URL="redis://localhost:6379"

JWT_SECRET="oooa-dev-secret-change-in-production"
JWT_EXPIRES_IN="7d"

PORT=3001
