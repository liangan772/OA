# 复制为 .env 后修改，docker compose 会自动读取
# 生产环境务必修改这两项

# PostgreSQL 口令（同时用于容器初始化与后端连接串）
POSTGRES_PASSWORD=change-me-strong-password

# JWT 签名密钥，随机长字符串，泄露等于所有登录态作废
JWT_SECRET=change-me-to-a-random-64-char-string

# 对外端口
WEB_PORT=8080
SERVER_PORT=3001

# 宿主机映射端口（仅调试需要，生产建议用 docker-compose.prod.yml 关掉）
POSTGRES_PORT=5432
REDIS_PORT=6379

# 登录态有效期
JWT_EXPIRES_IN=7d
